# Contact data is hardcoded in lib/site-config.ts — no env needed for it.

# Server-only lead delivery. Configure Telegram and/or a webhook — leads are
# sent to every configured channel (success if at least one accepts).

# Telegram bot (leads land in a chat/group). Get the token from @BotFather,
# and the chat id from @userinfobot (personal) or the group's numeric id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional generic webhook (CRM / n8n / Make). The token is optional.
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_TOKEN=""

# Sanity CMS (Studio at /studio). Project id comes from sanity.io/manage.
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
# Secret shared with the Sanity webhook that invalidates the cache on publish.
SANITY_REVALIDATE_SECRET=""
# Editor token — only needed locally for the one-off content migration.
SANITY_WRITE_TOKEN=""

# Kommo CRM. Subdomain is the account name from the address (acme.kommo.com).
# Token: Kommo → Settings → Integrations → your integration → long-lived token.
KOMMO_SUBDOMAIN=""
KOMMO_ACCESS_TOKEN=""
# Optional — where the deal lands. Empty = first pipeline, first stage.
KOMMO_PIPELINE_ID=""
KOMMO_STATUS_ID=""
KOMMO_RESPONSIBLE_USER_ID=""
