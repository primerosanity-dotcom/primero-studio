# Contact data is hardcoded in lib/site-config.ts — no env needed for it.

# Server-only lead delivery. Configure Telegram and/or a webhook — leads are
# sent to every configured channel (success if at least one accepts).

# Telegram bot (leads land in a chat/group). Get the token from @BotFather,
# and the chat id from @userinfobot (personal) or the group's numeric id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Optional generic webhook (CRM / n8n / Make). The token is optional.
LEAD_WEBHOOK_URL=""
LEAD_WEBHOOK_TOKEN=""
